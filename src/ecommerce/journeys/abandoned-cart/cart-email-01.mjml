<mjml>
  <mj-body>
    <mj-include path="../../components/header.mjml" />
    <mj-section background-color="#fff5e1">
      <mj-column>
        <mj-text
          font-size="20px"
          font-weight="bold"
          align="center"
          color="#794800"
        >
          Pick up where you left off.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#fff5e1" padding="20px 0 40px 0">
      <mj-column>
        <mj-text
          font-size="16px"
          color="#794800"
          line-height="1.5"
        >
          <strong>Hey {{customer.firstName}}</strong>,<br/><br/>
          It looks like you did not complete your checkout.</br>
          Fancy taking another look?
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#794800" padding="10px 0">
      <mj-column>
        <mj-text
          font-size="20px"
          font-weight="bold"
          color="#ffbd31"
        >
          Shopping Cart:
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#fff5e1" padding="20px">
      <mj-raw>
        {{#each cart.items}}
      </mj-raw>
      <mj-group>
        <mj-column width="20%" padding-bottom="10px">
          <mj-image
            src="{{image}}"
            alt=""
            padding="10px 0 0 0"
          />
        </mj-column>
        <mj-column width="80%" padding-bottom="10px">
          <mj-text
            font-size="16px"
            font-weight="bold"
            color="#794800"
          >
            {{name}}
          </mj-text>
          <mj-text
            font-size="16px"
            font-weight="bold"
            color="#794800"
          >
            x {{quantity}}
          </mj-text>
        </mj-column>
      </mj-group>
      <mj-raw>
        {{/each}}
      </mj-raw>
    </mj-section>
    <mj-include path="../../components/footer.mjml" />
  </mj-body>
</mjml>
