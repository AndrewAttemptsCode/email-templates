<mjml>
  <mj-head>
    <mj-style>
      @media only screen and (max-width: 480px) {
        .hero-center-text div {
          text-align: center !important;
        }
        .hero-center-btn table {
          margin: 0 auto !important;
        }
        .mobile-spec-text {
          font-size: 14px !important;
        }
      }
      .spec-layout th,
      .spec-layout td {
        padding: 4px 8px !important;
      }
    </mj-style>
  </mj-head>
  <mj-body>
    <mj-include path="../../components/header.mjml" />
    <mj-section
      background-color="#fff5e1"
      background-url="https://raw.githubusercontent.com/AndrewAttemptsCode/email-templates/refs/heads/main/src/assets/images/backgrounds/promotion_hero_bg.png"
      padding="20px"
    >
      <mj-column>
        <mj-text
          color="#fff5e1"
          font-size="16px"
          font-weight="bold"
          line-height="1.5"
          css-class="hero-center-text"
        >
          <span
            style="
              displaying: inline-block;
              background-color: #794800;
              padding: 8px 16px;
              border-radius: 5px;
            "
          >
            NEW
          </span>
        </mj-text>
        <mj-text
          color="#794800"
          font-size="20px"
          font-weight="bold"
          line-height="1.5"
          css-class="hero-center-text"
        >
          Meet the {{promotion.name}}
        </mj-text>
        <mj-text
          color="#794800"
          font-size="16px"
          line-height="1.5"
          css-class="hero-center-text"
        >
          {{promotion.tagline1}}<br/>
          {{promotion.tagline2}}
        </mj-text>
        <mj-text
          color="#794800"
          font-size="18px"
          font-weight="bold"
          line-height="1.5"
          css-class="hero-center-text"
        >
          {{promotion.price}}
        </mj-text>
        <mj-button
          align="left"
          color="#fff5e1"
          background-color="#794800"
          font-size="16px"
          font-weight="bold"
          border-radius="5px"
          href="{{promotion.url}}"
          css-class="hero-center-btn"
        >
          Shop the {{promotion.name}}
        </mj-button>
      </mj-column>
      <mj-column width="50%">
        <mj-image
          src="{{promotion.image}}"
          alt=""
          padding="0"
        />
      </mj-column>
    </mj-section>
    <mj-section background-color="#fff5e1">
      <mj-column>
        <mj-text
          font-weight="bold"
          font-size="20px"
          align="center"
          color="#794800"
        >
          {{promotion.introduction.title}}
        </mj-text>
        <mj-text
          font-size="16px"
          color="#794800"
          line-height="1.5"
        >
          {{promotion.introduction.body}}
        </mj-text>
        <mj-divider border-width="1px" border-color="#794800" width="80%" />
        <mj-raw>
        {{#each promotion.introduction.benefits}}
        </mj-raw>
        <mj-text
          color="#794800"
          font-size="20px"
          font-weight="bold"
        >
          {{title}}
        </mj-text>
        <mj-text
          color="#794800"
          font-size="16px"
          padding-top="0"
          line-height="1.5"
        >
          {{description}}
        </mj-text>
        <mj-raw>
        {{/each}}
        </mj-raw>
      </mj-column>
    </mj-section>
    <mj-section background-color="#794800">
      <mj-column>
        <mj-text
          color="#fff5e1"
          align="center"
          font-size="20px"
          font-weight="bold"
          padding="0 0 10px 0"
        >
          {{promotion.name}} Technical Specifications
        </mj-text>
        <mj-table>
          <tr
            class="spec-layout mobile-spec-text"
            style="
              background-color: #fff5e1;
              border: 1px solid #fff5e1;
              color: #794800;
              text-align: left;
              font-size: 16px;
            "
          >
            <th>
              Specification
            </th>
            <th>
              Details
            </th>
          </tr>
          <mj-raw>
            {{#each promotion.specifications}}
          </mj-raw>
          <tr
            class="spec-layout mobile-spec-text"
            style="
              color: #ffbd31;
              text-align: left;
              border: 1px solid #fff5e1;
              font-size: 16px;
            "
          >
            <td>
              {{@key}}
            </td>
            <td>
              {{this}}
            </td>
          </tr>
          <mj-raw>
            {{/each}}
          </mj-raw>
        </mj-table>
      </mj-column>
    </mj-section>
    <mj-section background-color="#fff5e1">
      <mj-column>
        <mj-text
          line-height="1.5"
          color="#794800"
          font-size="20px"
          font-weight="bold"
          align="center"
        >
          Exclusive launch offer
        </mj-text>
        <mj-text
          line-height="1.5"
          color="#794800"
          font-size="16px"
          align="center"
        >
          Be among the first to experience the new <strong>{{promotion.name}}</strong>.
        </mj-text>
        <mj-text
          line-height="1.5"
          color="#794800"
          font-size="16px"
          align="center"
        >
          Save 10%, available for a limited time.
        </mj-text>
        <mj-button
          color="#fff5e1"
          background-color="#794800"
          font-size="16px"
          font-weight="bold"
          border-radius="5px"
          href="{{promotion.url}}"
        >
          Take advantage
        </mj-button>
      </mj-column>
    </mj-section>
    <mj-include path="../../components/footer.mjml" />
  </mj-body>  
</mjml>
