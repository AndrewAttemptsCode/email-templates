<mjml>
  <mj-head>
    <mj-preview>
      Keep your setup going - Storm Tech
    </mj-preview>
    <mj-style>
      @media only screen and (max-width: 480px) {
        .mobile-title div {
          font-size: 18px !important;
        }
        .mobile-spacer {
          height: 20px !important;
        }
      }
      .product-image img {
        height: 200px !important;
        object-fit: contain !important;
      }
    </mj-style>
  </mj-head>
  <mj-body>
    <mj-include path="../../components/header.mjml" />
    <mj-section background-color="#fff5e1">
      <mj-column>
        <mj-text
          font-weight="bold"
          font-size="20px"
          color="#794800"
          align="center"
          css-class="mobile-title"
          line-height="1.2"
        >
          Make the most of your new setup!
        </mj-text>
        <mj-divider padding="20px" border-width="1px" border-color="#794800" width="80%" />
        <mj-text
          font-size="16px"
          color="#794800"
          line-height="1.5"
        >
          <strong>Hey {{customer.firstName}}</strong>,<br/><br/>
          Based on your recent order, I've picked out a couple of items you might be interested in. 
          I hope you like them!
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#fff5e1" padding="0 25px">
      <mj-column>
        <mj-text
          color="#ffbd31"
          font-size="20px"
          font-weight="bold"
          css-class="mobile-title"
          padding="0"
        >
          <span
            style="
              display: inline-block;
              background-color: #794800;
              padding: 8px 16px;
              border-radius: 0 8px 0 0;
            "
          >
            Picked for your setup
          </span>
        </mj-text>
        <mj-divider padding="0" border-width="2px" border-color="#794800" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#fff5e1" padding="20px">
      <mj-raw>
      {{#each recommendations.items}}
      </mj-raw>
      <mj-column width="48%" border="1px solid #794800" border-radius="14px">
        <mj-image
          src="{{image}}"
          href="{{url}}"
          alt=""
          css-class="product-image"
        />
        <mj-text
          align="center"
          font-weight="bold"
          height="26px"
          padding="0"
        >
          <a
            href="{{url}}"
            style="
              display: block;
              text-decoration: none;
              color: #fff5e1;
              background-color: #794800;
              border-radius: 0 0 14px 14px;
              padding: 8px 0;
            "
          >
            {{name}}
          </a>
        </mj-text>
      </mj-column>
      <mj-raw>
      {{#if @first}}
      </mj-raw>
      <mj-column width="4%" css-class="mobile-spacer" />
      <mj-raw>
      {{/if}}
      </mj-raw>
      <mj-raw>
      {{/each}}
      </mj-raw>
    </mj-section>
    <mj-section background-color="#fff5e1" padding-top="0">
      <mj-column>
        <mj-divider padding="20px" border-width="1px" border-color="#794800" width="80%" />
        <mj-text
          font-weight="bold"
          font-size="20px"
          color="#794800"
          align="center"
          css-class="mobile-title"
          line-height="1.2"
        >
          Not quite what you're looking for?
        </mj-text>
        <mj-text
          font-size="16px"
          color="#794800"
          align="center"
          line-height="1.5"
        >
          <em>Explore more products and find something that's right for you.</em>
        </mj-text>
        <mj-button
          background-color="#794800"
          color="#fff5e1"
          border-radius="25px"
          font-weight="bold"
          font-size="16px"
          border-bottom="3px solid #ffbd31"
          inner-padding="15px 25px"
          href="{{emailConfig.company.website}}"
        >
          SHOP NOW
        </mj-button>
      </mj-column>
    </mj-section>
    <mj-include path="../../components/footer.mjml" />
  </mj-body>  
</mjml>
