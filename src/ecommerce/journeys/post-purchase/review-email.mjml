<mjml>
  <mj-head>
    <mj-preview>
      Regarding your recent purchase at Storm Tech.
    </mj-preview>
    <mj-style>
    @media only screen and (max-width: 480px) {
      .mobile-title div {
        font-size: 18px !important;
      }
    }
    </mj-style>
  </mj-head>
  <mj-body>
    <mj-include path="../../components/header.mjml" />
    <mj-section background-color="#fff5e1">
      <mj-column>
        <mj-text
          font-weight="bold"
          font-size="20px"
          color="#794800"
          align="center"
          css-class="mobile-title"
        >
          How was your order?
        </mj-text>
        <mj-text
          align="center"
          color="#f5b301"
          font-size="30px"
          padding-top="0"
        >
          ★★★★★
        </mj-text>
        <mj-text
          font-size="16px"
          color="#794800"
          align="center"
          line-height="1.5"
        >
          We'd love to hear your feedback on your recent items. 
          Please share your experience in a review to help other people like you.
        </mj-text>
        <mj-divider border-width="1px" border-color="#794800" width="80%" />
      </mj-column>
    </mj-section>
    <mj-include path="../../components/footer.mjml" />
  </mj-body>  
</mjml>
