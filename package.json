{
  "name": "email-templates",
  "version": "1.0.0",
  "description": "Email Developing with MJML",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch": "mjml -w src/ecommerce/journeys/**/*.mjml -o src/ecommerce/dist --config.allowIncludes true --config.includePath src/ecommerce",
    "build": "mjml src/templates/*.mjml -o dist && node renderHandlebars.js",
    "build:ecommerce": "mjml src/ecommerce/journeys/post-purchase/recommendation-email.mjml -o src/ecommerce/dist --config.allowIncludes true --config.includePath src/ecommerce && node renderHandlebars.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewAttemptsCode/email-templates.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AndrewAttemptsCode/email-templates/issues"
  },
  "homepage": "https://github.com/AndrewAttemptsCode/email-templates#readme",
  "dependencies": {
    "dotenv": "^17.4.2",
    "handlebars": "^4.7.9",
    "mjml": "^5.4.0",
    "nodemailer": "^9.0.1"
  }
}
